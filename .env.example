# Скопируйте в .env и заполните. Без ключа соответствующий блок отчёта не выдумывает
# данные, а честно пишет, что источник недоступен.

# Спрос по ключевым словам: Google Keyword Planner через актор Apify.
# apify.com -> Settings -> Integrations -> Personal API tokens
APIFY_API_TOKEN=

# Выводы от Клода. console.anthropic.com -> API keys
ANTHROPIC_API_KEY=

# Необязательно: модель для выводов (по умолчанию claude-sonnet-5)
# PBA_AI_MODEL=claude-sonnet-5

# --- Доступ к сайту ---
# Обязательно при выкладке на хостинг: без PBA_PASSWORD сайт извне отвечает 503,
# а не открывается всем (за формой платные ключи и бюджеты клиента).
# Локальный запуск через start.bat пароля не требует.
PBA_USER=havas
PBA_PASSWORD=
